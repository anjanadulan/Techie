<?xml version="1.0" encoding="utf-8" ?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/customer_bg"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    tools:context=".UserProfile"
    >

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp"
            >

            <!-- Title & Subtitle -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="My Profile"
                android:textColor="@color/customer_text"
                android:textSize="28sp"
                android:textStyle="bold"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Account information, device telemetry &amp; permissions"
                android:textColor="@color/customer_muted"
                android:textSize="13sp"
                />

            <!-- User Info Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_customer_card"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="22dp"
                >

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_customer_soft_blue"
                    android:padding="16dp"
                    android:src="@drawable/ic_customer_profile"
                    />

                <TextView
                    android:id="@+id/tvProfileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/customer_text"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="Client Name"
                    />

                <TextView
                    android:id="@+id/tvProfileEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/customer_muted"
                    android:textSize="14sp"
                    tools:text="client@example.com"
                    />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_status_success"
                    android:paddingStart="12dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="4dp"
                    android:text="✓ Verified Client"
                    android:textColor="@color/customer_success"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    />
            </LinearLayout>

            <!-- Current Location Text Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_customer_card"
                android:orientation="vertical"
                android:padding="18dp"
                >

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    >

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="CURRENT LOCATION &amp; GPS"
                        android:textColor="@color/customer_muted"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        />

                    <TextView
                        android:id="@+id/btnRefreshLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?android:attr/selectableItemBackground"
                        android:padding="4dp"
                        android:text="🔄 Refresh GPS"
                        android:textColor="@color/customer_blue"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    >

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_customer_soft_blue"
                        android:padding="5dp"
                        android:src="@drawable/ic_customer_location"
                        />

                    <TextView
                        android:id="@+id/tvCurrentLocationText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="Acquiring GPS location fix..."
                        android:textColor="@color/customer_text"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvNearestBranchText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_customer_soft_orange"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp"
                    android:text="📍 Nearest Branch: Calculating..."
                    android:textColor="@color/customer_orange"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    />

                <TextView
                    android:id="@+id/btnOpenMap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:text="Open Interactive Branch Map ›"
                    android:textColor="@color/customer_blue"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    />
            </LinearLayout>

            <!-- Working Repair Overview Card -->
            <LinearLayout
                android:id="@+id/cardRepairOverview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_customer_card"
                android:orientation="vertical"
                android:padding="18dp"
                >

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    >

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="REPAIR &amp; BILLING OVERVIEW"
                        android:textColor="@color/customer_muted"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        />

                    <TextView
                        android:id="@+id/btnViewBookingHistoryHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?android:attr/selectableItemBackground"
                        android:text="History ›"
                        android:textColor="@color/customer_blue"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    >

                    <!-- Active Column -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        >

                        <TextView
                            android:id="@+id/tvActiveCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/customer_orange"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Active"
                            android:textColor="@color/customer_muted"
                            android:textSize="12sp"
                            />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="44dp"
                        android:background="@color/customer_border"
                        />

                    <!-- Completed Column -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        >

                        <TextView
                            android:id="@+id/tvCompletedCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/customer_success"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Completed"
                            android:textColor="@color/customer_muted"
                            android:textSize="12sp"
                            />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="44dp"
                        android:background="@color/customer_border"
                        />

                    <!-- Total Paid Column -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:gravity="center"
                        android:orientation="vertical"
                        >

                        <TextView
                            android:id="@+id/tvTotalSpent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="LKR 0"
                            android:textColor="@color/customer_blue"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Total Paid"
                            android:textColor="@color/customer_muted"
                            android:textSize="12sp"
                            />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="10dp"
                    android:background="@color/customer_border"
                    />

                <TextView
                    android:id="@+id/btnViewBookingHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:paddingVertical="4dp"
                    android:text="Manage Bookings &amp; Invoices ›"
                    android:textColor="@color/customer_text"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    />
            </LinearLayout>

            <!-- Permission Manager Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_customer_card"
                android:orientation="vertical"
                android:padding="18dp"
                >

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DEVICE PERMISSION MANAGER"
                    android:textColor="@color/customer_muted"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Hardware access requested for repair diagnostics"
                    android:textColor="@color/customer_muted"
                    android:textSize="12sp"
                    />

                <!-- Camera Row -->
                <LinearLayout
                    android:id="@+id/rowCameraPermission"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="6dp"
                    >

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        >

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📷 Camera Access"
                            android:textColor="@color/customer_text"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Capture diagnostic device damage photos"
                            android:textColor="@color/customer_muted"
                            android:textSize="11sp"
                            />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvCameraStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_status_success"
                        android:paddingStart="10dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="4dp"
                        android:text="GRANTED ✓"
                        android:textColor="@color/customer_success"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="6dp"
                    android:background="@color/customer_border"
                    />

                <!-- Location Row -->
                <LinearLayout
                    android:id="@+id/rowLocationPermission"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="6dp"
                    >

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        >

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📍 GPS Location Access"
                            android:textColor="@color/customer_text"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Automated nearest branch locator &amp; Maps"
                            android:textColor="@color/customer_muted"
                            android:textSize="11sp"
                            />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvLocationStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_status_success"
                        android:paddingStart="10dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="4dp"
                        android:text="GRANTED ✓"
                        android:textColor="@color/customer_success"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="6dp"
                    android:background="@color/customer_border"
                    />

                <!-- Storage / Media Row -->
                <LinearLayout
                    android:id="@+id/rowStoragePermission"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="6dp"
                    >

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        >

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📁 Media &amp; Storage"
                            android:textColor="@color/customer_text"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Upload receipts &amp; screenshots from gallery"
                            android:textColor="@color/customer_muted"
                            android:textSize="11sp"
                            />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvStorageStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_status_success"
                        android:paddingStart="10dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="4dp"
                        android:text="GRANTED ✓"
                        android:textColor="@color/customer_success"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnOpenAppSettings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:text="Open Android App Settings ›"
                    android:textColor="@color/customer_blue"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    />
            </LinearLayout>

            <!-- Change Password Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnAdminResetPassword"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_customer_card"
                android:stateListAnimator="@null"
                android:text="Change Password"
                android:textAllCaps="false"
                android:textColor="@color/customer_blue"
                android:textSize="15sp"
                android:textStyle="bold"
                />

            <!-- Sign Out Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnProfileSignOut"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_customer_nav"
                android:stateListAnimator="@null"
                android:text="@string/logout"
                android:textAllCaps="false"
                android:textColor="@color/customer_danger"
                android:textSize="15sp"
                android:textStyle="bold"
                />

        </LinearLayout>
    </ScrollView>

    <include layout="@layout/view_customer_bottom_nav" />
</LinearLayout>
