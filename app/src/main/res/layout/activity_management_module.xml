<?xml version="1.0" encoding="utf-8" ?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/management_bg"
    android:orientation="vertical"
    tools:context=".ManagementModuleActivity"
    android:paddingTop="20dp"
>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="108dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp">

        <TextView
            android:id="@+id/btnModuleBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_management_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/management_text"
            android:textSize="30sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvModuleEyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.14"
                android:text="OPERATIONS"
                android:textColor="@color/management_cyan"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvModuleTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/management_text"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="Appointments" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnModuleAdd"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_management_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="+"
            android:textColor="@color/management_bg"
            android:textSize="25sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/refreshLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
    >

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="30dp"
        >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:background="@drawable/bg_management_hero"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
            >

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                >
                    <TextView
                        android:id="@+id/tvModuleMetric"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/management_text"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        tools:text="12"
                    />
                    <TextView
                        android:id="@+id/tvModuleMetricLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/management_muted"
                        android:textSize="12sp"
                        tools:text="appointments today"
                    />
                </LinearLayout>
                <TextView
                    android:id="@+id/tvModuleTrend"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_management_status"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/management_green"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="+18% WEEK"
                />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:overScrollMode="never"
                android:scrollbars="none"
            >
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                >
                    <TextView
                        android:id="@+id/filterAll"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_management_chip_active"
                        android:gravity="center"
                        android:paddingHorizontal="16dp"
                        android:text="All"
                        android:textColor="@color/management_cyan"
                        android:textSize="12sp"
                        android:textStyle="bold"
                    />
                    <TextView
                        android:id="@+id/filterColombo"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginStart="9dp"
                        android:background="@drawable/bg_management_chip"
                        android:gravity="center"
                        android:paddingHorizontal="16dp"
                        android:text="Colombo"
                        android:textColor="@color/management_muted"
                        android:textSize="12sp"
                    />
                    <TextView
                        android:id="@+id/filterGalle"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginStart="9dp"
                        android:background="@drawable/bg_management_chip"
                        android:gravity="center"
                        android:paddingHorizontal="16dp"
                        android:text="Galle"
                        android:textColor="@color/management_muted"
                        android:textSize="12sp"
                    />
                </LinearLayout>
            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
            >
                <TextView
                    android:id="@+id/tvModuleSection"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/management_text"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="Current queue"
                />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Newest first"
                    android:textColor="@color/management_muted"
                    android:textSize="11sp"
                />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/managementList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
            />
        </LinearLayout>
    </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
