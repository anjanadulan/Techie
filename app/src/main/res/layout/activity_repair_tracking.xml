            <LinearLayout style="@style/TimelineRow"><TextView style="@style/TimelinePending" android:text="5"/><LinearLayout style="@style/TimelineText"><TextView style="@style/TimelineTitle" android:text="Ready for collection"/><TextView style="@style/TimelineSubtitle" android:text="We’ll notify you when it’s ready"/></LinearLayout></LinearLayout>
