        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_customer_card" android:orientation="vertical" android:padding="20dp">
            <LinearLayout style="@style/TimelineRow"><TextView style="@style/TimelineDone" android:text="✓"/><LinearLayout style="@style/TimelineText"><TextView style="@style/TimelineTitle" android:text="Appointment confirmed"/><TextView style="@style/TimelineSubtitle" android:text="Today · 9:15 AM"/></LinearLayout></LinearLayout>
            <LinearLayout style="@style/TimelineRow"><TextView style="@style/TimelineDone" android:text="✓"/><LinearLayout style="@style/TimelineText"><TextView style="@style/TimelineTitle" android:text="Device received"/><TextView style="@style/TimelineSubtitle" android:text="Today · 10:02 AM"/></LinearLayout></LinearLayout>
            <LinearLayout style="@style/TimelineRow"><TextView style="@style/TimelineCurrent" android:text="3"/><LinearLayout style="@style/TimelineText"><TextView style="@style/TimelineTitle" android:text="Repair in progress"/><TextView style="@style/TimelineSubtitle" android:text="Your technician is replacing the display"/></LinearLayout></LinearLayout>
