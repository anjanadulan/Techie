<?xml version="1.0" encoding="utf-8" ?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/customer_bg"
    android:orientation="vertical"
    tools:context=".RepairHistoryActivity"
>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
    >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp"
        >
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/repair_history"
                android:textColor="@color/customer_text"
                android:textSize="31sp"
                android:textStyle="bold"
            />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="@string/history_subtitle"
                android:textColor="@color/customer_muted"
            />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal"
            >
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_customer_chip_selected"
                    android:text="All"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_customer_chip"
                    android:text="Active"
                />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_customer_chip"
                    android:text="Completed"
                />
            </LinearLayout>
            <LinearLayout android:id="@+id/historyActiveRepair" style="@style/HistoryCard">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                >
                    <TextView style="@style/HistoryId" android:text="#TF-2048 · 01 Aug 2026" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_status_success"
                        android:text="In progress"
                        android:textColor="@color/customer_success"
                        android:textSize="11sp"
                        android:textStyle="bold"
                    />
                </LinearLayout>
                <TextView style="@style/HistoryTitle" android:text="Samsung Galaxy S23" />
                <TextView
                    style="@style/HistorySubtitle"
                    android:text="Screen replacement · Colombo branch"
                />
                <TextView style="@style/HistoryPrice" android:text="Estimated · LKR 12,500" />
            </LinearLayout>
            <LinearLayout style="@style/HistoryCard">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                >
                    <TextView style="@style/HistoryId" android:text="#TF-1982 · 12 Jul 2026" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_status_success"
                        android:text="Completed"
                        android:textColor="@color/customer_success"
                        android:textSize="11sp"
                        android:textStyle="bold"
                    />
                </LinearLayout>
                <TextView style="@style/HistoryTitle" android:text="Dell Inspiron 15" />
                <TextView
                    style="@style/HistorySubtitle"
                    android:text="Keyboard repair · Galle branch"
                />
                <TextView style="@style/HistoryPrice" android:text="Paid · LKR 7,500" />
            </LinearLayout>
            <LinearLayout style="@style/HistoryCard">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                >
                    <TextView style="@style/HistoryId" android:text="#TF-1814 · 21 May 2026" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_status_cancelled"
                        android:text="Cancelled"
                        android:textColor="@color/customer_danger"
                        android:textSize="11sp"
                        android:textStyle="bold"
                    />
                </LinearLayout>
                <TextView style="@style/HistoryTitle" android:text="Apple iPad Air" />
                <TextView
                    style="@style/HistorySubtitle"
                    android:text="Device diagnostics · Colombo branch"
                />
                <TextView style="@style/HistoryPrice" android:text="No payment" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <include layout="@layout/view_customer_bottom_nav" />
</LinearLayout>
