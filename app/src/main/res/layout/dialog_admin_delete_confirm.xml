<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header: Warning Tag & Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_status_cancelled"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        android:text="⚠️ PERMANENT REMOVAL"
        android:textColor="@color/customer_danger"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvDeleteDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Delete This Record?"
        android:textColor="@color/customer_text"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvDeleteDialogMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingMultiplier="1.2"
        android:text="Are you sure you want to remove this item from the Cloud Firestore database? This action cannot be reversed."
        android:textColor="@color/customer_muted"
        android:textSize="13sp" />

    <!-- Bottom Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnDeleteCancel"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/bg_customer_input"
            android:text="Keep Record"
            android:textAllCaps="false"
            android:textColor="@color/customer_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnDeleteConfirm"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1.2"
            android:background="@drawable/bg_status_cancelled"
            android:text="Delete Now"
            android:textAllCaps="false"
            android:textColor="@color/customer_danger"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
