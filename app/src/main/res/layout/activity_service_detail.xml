<?xml version="1.0" encoding="utf-8" ?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/customer_bg"
    android:orientation="vertical"
    tools:context=".ServiceDetailActivity"
>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="20dp"
    >
        <TextView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/customer_text"
            android:textSize="38sp"
        />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/service_detail"
            android:textColor="@color/customer_text"
            android:textSize="17sp"
            android:textStyle="bold"
        />
        <Space android:layout_width="48dp" android:layout_height="48dp" />
    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
    >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp"
        >
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="226dp"
                android:background="@drawable/bg_customer_soft_blue"
            >
                <ImageView
                    android:layout_width="108dp"
                    android:layout_height="108dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/screen_replacement"
                    android:src="@drawable/ic_customer_phone"
                />
            </FrameLayout>
            <TextView
                android:id="@+id/tvServiceName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/screen_replacement"
                android:textColor="@color/customer_text"
                android:textSize="28sp"
                android:textStyle="bold"
            />
            <TextView
                android:id="@+id/tvServiceDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="4dp"
                android:text="@string/screen_replacement_description"
                android:textColor="@color/customer_muted"
                android:textSize="14sp"
            />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="104dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_customer_card"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="8dp"
            >
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                >
                    <TextView
                        android:id="@+id/tvServicePrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LKR 8,500"
                        android:textColor="@color/customer_orange"
                        android:textSize="15sp"
                        android:textStyle="bold"
                    />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="@string/starting_price"
                        android:textColor="@color/customer_muted"
                        android:textSize="11sp"
                    />
                </LinearLayout>
                <View
                    android:layout_width="1dp"
                    android:layout_height="46dp"
                    android:background="@color/customer_border"
                />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                >
                    <TextView
                        android:id="@+id/tvServiceTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1–2 hrs"
                        android:textColor="@color/customer_text"
                        android:textSize="15sp"
                        android:textStyle="bold"
                    />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="@string/repair_time"
                        android:textColor="@color/customer_muted"
                        android:textSize="11sp"
                    />
                </LinearLayout>
                <View
                    android:layout_width="1dp"
                    android:layout_height="46dp"
                    android:background="@color/customer_border"
                />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                >
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="6 months"
                        android:textColor="@color/customer_text"
                        android:textSize="15sp"
                        android:textStyle="bold"
                    />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="@string/warranty"
                        android:textColor="@color/customer_muted"
                        android:textSize="11sp"
                    />
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="@string/service_includes"
                android:textColor="@color/customer_text"
                android:textSize="18sp"
                android:textStyle="bold"
            />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:lineSpacingExtra="9dp"
                android:text="✓  Full device inspection\n✓  Quality-tested replacement display\n✓  Installation and display calibration\n✓  Six-month service warranty"
                android:textColor="@color/customer_text"
                android:textSize="14sp"
            />
        </LinearLayout>
    </ScrollView>
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnBookRepair"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_customer_primary"
        android:stateListAnimator="@null"
        android:text="@string/book_repair"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
    />
</LinearLayout>
