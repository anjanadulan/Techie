<?xml version="1.0" encoding="utf-8" ?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050912"
>
    <androidx.camera.view.PreviewView
        android:id="@+id/repairCameraPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Camera preview for repaired device"
        app:scaleType="fillCenter"
    />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="104dp"
        android:background="#A6050912"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
    >
        <TextView
            android:id="@+id/btnCloseRepairCamera"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_camera_control"
            android:gravity="center"
            android:text="×"
            android:textColor="@color/white"
            android:textSize="28sp"
        />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical"
        >
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.14"
                android:text="TECHFIX CAMERA"
                android:textColor="@color/management_cyan"
                android:textSize="10sp"
                android:textStyle="bold"
            />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Capture repaired device"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
            />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_gravity="bottom"
        android:background="#B3050912"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
    >
        <View
            android:layout_width="52dp"
            android:layout_height="52dp"
        />
        <TextView
            android:id="@+id/btnCaptureRepairImage"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_marginHorizontal="34dp"
            android:background="@drawable/bg_camera_capture"
            android:contentDescription="Take repaired device photo"
            android:enabled="false"
        />
        <TextView
            android:id="@+id/btnFlipRepairCamera"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_camera_control"
            android:contentDescription="Switch camera"
            android:gravity="center"
            android:text="↻"
            android:textColor="@color/white"
            android:textSize="25sp"
        />
    </LinearLayout>
</FrameLayout>
