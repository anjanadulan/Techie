<?xml version="1.0" encoding="utf-8" ?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/management_bg"
    android:orientation="vertical"
    tools:context=".ManagerDashboard"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        >

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical"
            >

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.16"
                android:text="Manager Dashboard"
                android:textColor="@color/management_text"
                android:textSize="10sp"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Overview &amp; Repair Control Panel"
                android:textColor="@color/management_cyan"
                android:textSize="16sp"
                android:textStyle="bold"
                />
        </LinearLayout>

        <TextView
            android:id="@+id/btnAdminProfile"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="@drawable/bg_management_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="Admin profile"
            android:textColor="@color/management_text"
            android:textSize="12sp"
            />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="30dp"
            >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_management_hero"
                android:orientation="vertical"
                android:padding="22dp"
                >

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LIVE OPERATIONS"
                    android:textColor="@color/management_cyan"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Everything is moving."
                    android:textColor="@color/management_text"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    />

                <TextView
                    android:id="@+id/tvDashboardSummary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="8 repairs active across Colombo and Galle"
                    android:textColor="@color/management_muted"
                    android:textSize="13sp"
                    />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:orientation="horizontal"
                    >

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        >
                        <TextView
                            android:id="@+id/tvDashboardActive"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="08"
                            android:textColor="@color/management_text"
                            android:textSize="25sp"
                            android:textStyle="bold"
                            />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ACTIVE"
                            android:textColor="@color/management_muted"
                            android:textSize="10sp"
                            />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        >
                        <TextView
                            android:id="@+id/tvDashboardReady"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="03"
                            android:textColor="@color/management_green"
                            android:textSize="25sp"
                            android:textStyle="bold"
                            />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="READY"
                            android:textColor="@color/management_muted"
                            android:textSize="10sp"
                            />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        >
                        <TextView
                            android:id="@+id/tvDashboardLowStock"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="02"
                            android:textColor="@color/management_amber"
                            android:textSize="25sp"
                            android:textStyle="bold"
                            />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="LOW STOCK"
                            android:textColor="@color/management_muted"
                            android:textSize="10sp"
                            />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                >
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Manage"
                    android:textColor="@color/management_text"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="9 MODULES"
                    android:textColor="@color/management_muted"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                >
                <LinearLayout
                    android:id="@+id/manageAppointments"
                    style="@style/ManagementModuleCard"
                    android:layout_marginEnd="7dp"
                    >
                    <TextView
                        style="@style/ManagementModuleCode"
                        android:text="APPT"
                        />
                    <TextView
                        style="@style/ManagementModuleTitle"
                        android:text="Appointments"
                        />
                    <TextView
                        android:id="@+id/tvDashboardAppointmentsMeta"
                        style="@style/ManagementModuleMeta"
                        android:text="12 today · 4 new"
                        />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/manageTechnicians"
                    style="@style/ManagementModuleCard"
                    android:layout_marginStart="7dp"
                    >
                    <TextView
                        style="@style/ManagementModuleCode"
                        android:text="TEAM"
                        />
                    <TextView
                        style="@style/ManagementModuleTitle"
                        android:text="Technicians"
                        />
                    <TextView
                        android:id="@+id/tvDashboardTechniciansMeta"
                        style="@style/ManagementModuleMeta"
                        android:text="4 active · 1 busy"
                        />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                >
                <LinearLayout
                    android:id="@+id/manageBranches"
                    style="@style/ManagementModuleCard"
                    android:layout_marginEnd="7dp"
                    >
                    <TextView
                        style="@style/ManagementModuleCode"
                        android:text="GPS"
                        />
                    <TextView
                        style="@style/ManagementModuleTitle"
                        android:text="Branches"
                        />
                    <TextView
                        android:id="@+id/tvDashboardBranchesMeta"
                        style="@style/ManagementModuleMeta"
                        android:text="2 locations"
                        />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/manageCategories"
                    style="@style/ManagementModuleCard"
                    android:layout_marginStart="7dp"
                    >
                    <TextView
                        style="@style/ManagementModuleCode"
                        android:text="TYPE"
                        />
                    <TextView
                        style="@style/ManagementModuleTitle"
                        android:text="Device categories"
                        />
                    <TextView
                        android:id="@+id/tvDashboardCategoriesMeta"
                        style="@style/ManagementModuleMeta"
                        android:text="4 categories"
                        />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                >
                <LinearLayout
                    android:id="@+id/managePrices"
                    style="@style/ManagementModuleCard"
                    android:layout_marginEnd="7dp"
                    >
                    <TextView
                        style="@style/ManagementModuleCode"
                        android:text="RATE"
                        />
                    <TextView
                        style="@style/ManagementModuleTitle"
                        android:text="Service prices"
                        />
                    <TextView
                        style="@style/ManagementModuleMeta"
                        android:text="5 services"
                        />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/manageParts"
                    style="@style/ManagementModuleCard"
                    android:layout_marginStart="7dp"
                    >
                    <TextView
                        style="@style/ManagementModuleCode"
                        android:text="STOCK"
                        />
                    <TextView
                        style="@style/ManagementModuleTitle"
                        android:text="Spare parts"
                        />
                    <TextView
                        android:id="@+id/tvDashboardPartsMeta"
                        style="@style/ManagementModuleMeta"
                        android:text="38 units · 2 low"
                        />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                >
                <LinearLayout
                    android:id="@+id/manageImages"
                    style="@style/ManagementModuleCard"
                    android:layout_marginEnd="7dp"
                    >
                    <TextView
                        style="@style/ManagementModuleCode"
                        android:text="MEDIA"
                        />
                    <TextView
                        style="@style/ManagementModuleTitle"
                        android:text="Repair gallery"
                        />
                    <TextView
                        android:id="@+id/tvDashboardImagesMeta"
                        style="@style/ManagementModuleMeta"
                        android:text="24 images"
                        />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/managePayments"
                    style="@style/ManagementModuleCard"
                    android:layout_marginStart="7dp"
                    >
                    <TextView
                        style="@style/ManagementModuleCode"
                        android:text="PAY"
                        />
                    <TextView
                        style="@style/ManagementModuleTitle"
                        android:text="Payments"
                        />
                    <TextView
                        android:id="@+id/tvDashboardPaymentsMeta"
                        style="@style/ManagementModuleMeta"
                        android:text="LKR 84.5K today"
                        />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/manageStatuses"
                android:layout_width="match_parent"
                android:layout_height="82dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_management_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="18dp"
                >
                <TextView
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_management_status"
                    android:gravity="center"
                    android:text="SYNC"
                    android:textColor="@color/management_green"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    >
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Repair status updates"
                        android:textColor="@color/management_text"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Move repairs through the workflow"
                        android:textColor="@color/management_muted"
                        android:textSize="12sp"
                        />
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="@color/management_cyan"
                    android:textSize="28sp"
                    />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="Recent activity"
                android:textColor="@color/management_text"
                android:textSize="19sp"
                android:textStyle="bold"
                />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_management_card"
                android:orientation="vertical"
                android:padding="18dp"
                >
                <TextView
                    android:id="@+id/tvDashboardActivityOne"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="#TF-1042 moved to Quality check"
                    android:textColor="@color/management_text"
                    android:textStyle="bold"
                    />
                <TextView
                    android:id="@+id/tvDashboardActivityOneMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Nimal Perera · Colombo · 8 min ago"
                    android:textColor="@color/management_muted"
                    android:textSize="12sp"
                    />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="16dp"
                    android:background="@color/management_border"
                    />
                <TextView
                    android:id="@+id/tvDashboardActivityTwo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Payment received for #TF-1038"
                    android:textColor="@color/management_text"
                    android:textStyle="bold"
                    />
                <TextView
                    android:id="@+id/tvDashboardActivityTwoMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="LKR 8,500 · Galle · 21 min ago"
                    android:textColor="@color/management_muted"
                    android:textSize="12sp"
                    />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
