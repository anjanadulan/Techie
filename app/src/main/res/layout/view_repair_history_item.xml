<?xml version="1.0" encoding="utf-8" ?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" style="@style/HistoryCard">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
    >
        <TextView android:id="@+id/historyItemId" style="@style/HistoryId" />
        <TextView
            android:id="@+id/historyItemStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_success"
            android:textColor="@color/customer_success"
            android:textSize="11sp"
            android:textStyle="bold"
        />
    </LinearLayout>
    <TextView android:id="@+id/historyItemTitle" style="@style/HistoryTitle" />
    <TextView android:id="@+id/historyItemSubtitle" style="@style/HistorySubtitle" />
    <TextView android:id="@+id/historyItemPrice" style="@style/HistoryPrice" />
</LinearLayout>
