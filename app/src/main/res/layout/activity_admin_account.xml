<?xml version="1.0" encoding="utf-8" ?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/management_bg"
    android:orientation="vertical"
    tools:context=".AdminAccountActivity"
>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
    >

        <TextView
            android:id="@+id/btnAdminBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_management_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/management_text"
            android:textSize="30sp"
        />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical"
        >

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.16"
                android:text="TECHFIX CONTROL"
                android:textColor="@color/management_cyan"
                android:textSize="10sp"
                android:textStyle="bold"
            />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Admin account"
                android:textColor="@color/management_text"
                android:textSize="20sp"
                android:textStyle="bold"
            />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
    >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="30dp"
        >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_management_hero"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="24dp"
            >

                <TextView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_management_chip_active"
                    android:gravity="center"
                    android:text="ADMIN"
                    android:textColor="@color/management_cyan"
                    android:textSize="11sp"
                    android:textStyle="bold"
                />

                <TextView
                    android:id="@+id/tvAdminName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:textColor="@color/management_text"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    tools:text="TechFix Administrator"
                />

                <TextView
                    android:id="@+id/tvAdminEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/management_muted"
                    tools:text="admin@techfix.lk"
                />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_management_status"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="MANAGER · ALL BRANCHES"
                    android:textColor="@color/management_green"
                    android:textSize="10sp"
                    android:textStyle="bold"
                />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="Workspace"
                android:textColor="@color/management_text"
                android:textSize="19sp"
                android:textStyle="bold"
            />

            <LinearLayout
                android:id="@+id/btnAdminDashboard"
                android:layout_width="match_parent"
                android:layout_height="78dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_management_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="18dp"
            >

                <TextView
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_management_chip_active"
                    android:gravity="center"
                    android:text="OPS"
                    android:textColor="@color/management_cyan"
                    android:textSize="10sp"
                    android:textStyle="bold"
                />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                >

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Management dashboard"
                        android:textColor="@color/management_text"
                        android:textStyle="bold"
                    />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Appointments, staff, inventory and payments"
                        android:textColor="@color/management_muted"
                        android:textSize="11sp"
                    />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="@color/management_cyan"
                    android:textSize="28sp"
                />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnAdminSync"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_management_button"
                android:stateListAnimator="@null"
                android:text="Synchronize Firebase data"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textStyle="bold"
            />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnAdminResetPassword"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_customer_card"
                android:stateListAnimator="@null"
                android:text="Change administrator password"
                android:textAllCaps="false"
                android:textColor="@color/customer_blue"
                android:textStyle="bold"
            />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnAdminLogout"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_management_chip"
                android:stateListAnimator="@null"
                android:text="Log out administrator"
                android:textAllCaps="false"
                android:textColor="@color/management_red"
                android:textStyle="bold"
            />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
