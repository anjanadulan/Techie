<?xml version="1.0" encoding="utf-8" ?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="12dp" android:background="@drawable/bg_customer_card"
    android:orientation="vertical" android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical">
        <TextView android:id="@+id/tvAvailabilityType" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:textColor="@color/customer_orange" android:textSize="10sp"
            android:textStyle="bold" />
        <TextView android:id="@+id/tvAvailabilityStatus" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textColor="@color/customer_success"
            android:textSize="11sp" android:textStyle="bold" />
    </LinearLayout>
    <TextView android:id="@+id/tvAvailabilityTitle" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="9dp"
        android:textColor="@color/customer_text" android:textSize="16sp"
        android:textStyle="bold" />
    <TextView android:id="@+id/tvAvailabilityBranch" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="5dp"
        android:textColor="@color/customer_muted" android:textSize="12sp" />
    <TextView android:id="@+id/tvAvailabilityDetail" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="5dp"
        android:textColor="@color/customer_text" android:textSize="12sp" />
</LinearLayout>
