<?xml version="1.0" encoding="utf-8" ?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:background="@drawable/bg_management_card"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="18dp"
>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
    >

        <TextView
            android:id="@+id/tvManagementItemCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_management_chip_active"
            android:paddingStart="9dp"
            android:paddingTop="5dp"
            android:paddingEnd="9dp"
            android:paddingBottom="5dp"
            android:textColor="@color/management_cyan"
            android:textSize="9sp"
            android:textStyle="bold"
            tools:text="#TF-1042"
        />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
        />

        <TextView
            android:id="@+id/tvManagementItemStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_management_status"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:textColor="@color/management_green"
            android:textSize="10sp"
            android:textStyle="bold"
            tools:text="IN PROGRESS"
        />
    </LinearLayout>

    <ImageView
        android:id="@+id/ivManagementItemPreview"
        android:layout_width="match_parent"
        android:layout_height="116dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_management_hero"
        android:contentDescription="Repair preview"
        android:padding="30dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_customer_phone"
        android:visibility="gone"
    />

    <TextView
        android:id="@+id/tvManagementItemTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:textColor="@color/management_text"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:text="iPhone 14 Pro · Screen replacement"
    />

    <TextView
        android:id="@+id/tvManagementItemMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/management_muted"
        android:textSize="12sp"
        tools:text="Colombo · Nimal Perera · 10:30 AM"
    />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="@color/management_border"
    />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
    >
        <TextView
            android:id="@+id/tvManagementItemDetail"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/management_muted"
            android:textSize="11sp"
            tools:text="Due in 45 minutes"
        />
        <TextView
            android:id="@+id/btnManagementItemAction"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_management_chip"
            android:gravity="center"
            android:paddingHorizontal="13dp"
            android:textColor="@color/management_cyan"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="UPDATE"
        />
    </LinearLayout>
</LinearLayout>
