<?xml version="1.0" encoding="utf-8" ?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/customer_bg"
    android:orientation="vertical"
    tools:context=".CustomerHomeActivity"
>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
    >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="22dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp"
        >
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
            >
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                >
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/customer_greeting"
                        android:textColor="@color/customer_muted"
                        android:textSize="14sp"
                    />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TechFix"
                        android:textColor="@color/customer_text"
                        android:textSize="21sp"
                        android:textStyle="bold"
                    />
                </LinearLayout>
                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_customer_soft_orange"
                    android:contentDescription="@string/brand_icon_description"
                    android:padding="10dp"
                    android:src="@drawable/ic_techfix_mark"
                />
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:lineSpacingExtra="-2dp"
                android:text="@string/customer_question"
                android:textColor="@color/customer_text"
                android:textSize="34sp"
                android:textStyle="bold"
            />
            <LinearLayout
                android:id="@+id/searchServices"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_customer_input"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
            >
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/search_services"
                    android:src="@drawable/ic_customer_search"
                />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/search_services"
                    android:textColor="@color/customer_muted"
                    android:textSize="14sp"
                />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
            >
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/device_categories"
                    android:textColor="@color/customer_text"
                    android:textSize="19sp"
                    android:textStyle="bold"
                />
                <TextView
                    android:id="@+id/openServices"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:text="@string/view_all"
                    android:textColor="@color/customer_orange"
                    android:textSize="13sp"
                    android:textStyle="bold"
                />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal"
            >
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="108dp"
                    android:layout_marginEnd="7dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_customer_card"
                    android:gravity="center"
                    android:orientation="vertical"
                >
                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:src="@drawable/ic_customer_phone"
                    />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:text="@string/phone"
                        android:textColor="@color/customer_text"
                        android:textStyle="bold"
                    />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="108dp"
                    android:layout_marginStart="7dp"
                    android:layout_marginEnd="7dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_customer_card"
                    android:gravity="center"
                    android:orientation="vertical"
                >
                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:src="@drawable/ic_customer_laptop"
                    />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:text="@string/laptop"
                        android:textColor="@color/customer_text"
                        android:textStyle="bold"
                    />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="108dp"
                    android:layout_marginStart="7dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_customer_card"
                    android:gravity="center"
                    android:orientation="vertical"
                >
                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:src="@drawable/ic_customer_phone"
                    />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:text="@string/tablet"
                        android:textColor="@color/customer_text"
                        android:textStyle="bold"
                    />
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/active_repair"
                android:textColor="@color/customer_text"
                android:textSize="19sp"
                android:textStyle="bold"
            />
            <LinearLayout
                android:id="@+id/activeRepairCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_customer_card"
                android:clickable="true"
                android:elevation="2dp"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="18dp"
            >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                >
                    <TextView
                        android:id="@+id/tvActiveRepairId"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/repair_id"
                        android:textColor="@color/customer_muted"
                        android:textSize="12sp"
                    />
                    <TextView
                        android:id="@+id/tvActiveRepairStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_status_success"
                        android:text="@string/repair_in_progress"
                        android:textColor="@color/customer_success"
                        android:textSize="11sp"
                        android:textStyle="bold"
                    />
                </LinearLayout>
                <TextView
                    android:id="@+id/tvActiveRepairSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/repair_active_summary"
                    android:textColor="@color/customer_text"
                    android:textSize="16sp"
                    android:textStyle="bold"
                />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="18dp"
                    android:background="@color/customer_orange_soft"
                />
                <View
                    android:layout_width="230dp"
                    android:layout_height="6dp"
                    android:layout_marginTop="-6dp"
                    android:background="@color/customer_orange"
                />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/view_details"
                    android:textColor="@color/customer_orange"
                    android:textStyle="bold"
                />
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/popular_services"
                android:textColor="@color/customer_text"
                android:textSize="19sp"
                android:textStyle="bold"
            />
            <LinearLayout
                android:id="@+id/popularService"
                android:layout_width="match_parent"
                android:layout_height="86dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_customer_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp"
            >
                <ImageView
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:background="@drawable/bg_customer_soft_blue"
                    android:padding="11dp"
                    android:src="@drawable/ic_customer_phone"
                />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                >
                    <TextView
                        android:id="@+id/tvPopularServiceName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/screen_replacement"
                        android:textColor="@color/customer_text"
                        android:textSize="15sp"
                        android:textStyle="bold"
                    />
                    <TextView
                        android:id="@+id/tvPopularServiceMeta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="From LKR 8,500 · 1–2 hours"
                        android:textColor="@color/customer_muted"
                        android:textSize="12sp"
                    />
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="@color/customer_text"
                    android:textSize="30sp"
                />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/openRepairGallery"
                android:layout_width="match_parent"
                android:layout_height="86dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_customer_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp"
            >
                <ImageView
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:background="@drawable/bg_customer_soft_orange"
                    android:padding="11dp"
                    android:src="@drawable/ic_customer_services"
                />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                >
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Repaired-device samples"
                        android:textColor="@color/customer_text"
                        android:textSize="15sp"
                        android:textStyle="bold"
                    />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="See real repairs captured by TechFix"
                        android:textColor="@color/customer_muted"
                        android:textSize="12sp"
                    />
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="@color/customer_orange"
                    android:textSize="30sp"
                />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <include layout="@layout/view_customer_bottom_nav" />
</LinearLayout>
