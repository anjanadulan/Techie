<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="3dp"
    app:strokeColor="@color/customer_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top Device Photo Banner with Overlays -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:background="@color/customer_blue_soft">

            <ImageView
                android:id="@+id/ivRepairedPhoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/bg_customer_card"
                android:contentDescription="Repaired Device Photo" />

            <!-- Fallback Icon if no photo URL -->
            <ImageView
                android:id="@+id/ivRepairedPlaceholder"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_techfix_mark"
                android:contentDescription="TechFix Verified Repair" />

            <!-- Status Tag -->
            <TextView
                android:id="@+id/tvRepairedStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="12dp"
                android:background="@drawable/bg_status_success"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="VERIFIED REPAIR"
                android:textColor="@color/customer_success"
                android:textSize="10sp"
                android:textStyle="bold" />

            <!-- Location Badge -->
            <TextView
                android:id="@+id/tvRepairedBranch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="12dp"
                android:background="@drawable/bg_customer_chip"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="📍 Colombo"
                android:textColor="@color/customer_text"
                android:textSize="11sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Body Details -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvRepairedDeviceName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Device Repair Title"
                android:textColor="@color/customer_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRepairedDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="2dp"
                android:text="Diagnostic notes and restoration details performed by technician."
                android:textColor="@color/customer_muted"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvRepairedCost"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="LKR 18,500"
                    android:textColor="@color/customer_orange"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnRequestSimilar"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_customer_primary"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="Request Similar Repair"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
