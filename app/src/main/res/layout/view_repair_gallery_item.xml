<?xml version="1.0" encoding="utf-8" ?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:background="@drawable/bg_customer_card"
    android:orientation="vertical"
    android:padding="12dp"
>
    <ImageView
        android:id="@+id/ivGalleryRepair"
        android:layout_width="match_parent"
        android:layout_height="210dp"
        android:background="@drawable/bg_customer_soft_blue"
        android:contentDescription="Featured repaired device"
        android:scaleType="centerCrop"
    />
    <TextView
        android:id="@+id/tvGalleryTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Device · Repair service"
        android:textColor="@color/customer_text"
        android:textSize="16sp"
        android:textStyle="bold"
    />
    <TextView
        android:id="@+id/tvGalleryMeta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Colombo · 01 Aug 2026"
        android:textColor="@color/customer_muted"
        android:textSize="12sp"
    />
</LinearLayout>
