<?xml version="1.0" encoding="utf-8" ?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/customer_bg"
    android:orientation="vertical"
    tools:context=".BookingHistory"
    >
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp"
            >
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/booking_history"
                android:textColor="@color/customer_text"
                android:textSize="31sp"
                android:textStyle="bold"
                />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="@string/history_subtitle"
                android:textColor="@color/customer_muted"
                />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal"
                >
                <TextView
                    android:id="@+id/filterAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_customer_chip_selected"
                    android:text="All"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    />
                <TextView
                    android:id="@+id/filterActive"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_customer_chip"
                    android:text="Active"
                    android:textColor="@color/customer_muted"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    />
                <TextView
                    android:id="@+id/filterCompleted"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_customer_chip"
                    android:text="Completed"
                    android:textColor="@color/customer_muted"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    />
            </LinearLayout>
            <TextView
                android:id="@+id/tvHistoryEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:gravity="center"
                android:text="Your repair appointments will appear here."
                android:textColor="@color/customer_muted"
                android:visibility="gone"
                />
            <LinearLayout
                android:id="@+id/repairHistoryList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                />
        </LinearLayout>
    </ScrollView>
    <include layout="@layout/view_customer_bottom_nav" />
</LinearLayout>
