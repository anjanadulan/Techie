<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="96dp"
    android:layout_marginTop="12dp"
    android:background="@drawable/bg_customer_card"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp"
>
    <ImageView
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:background="@drawable/bg_customer_soft_blue"
        android:padding="12dp"
        android:src="@drawable/ic_customer_laptop"
    />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical"
    >
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Keyboard repair"
            android:textColor="@color/customer_text"
            android:textSize="15sp"
            android:textStyle="bold"
        />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Laptop and desktop keyboards"
            android:textColor="@color/customer_muted"
            android:textSize="12sp"
        />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="From LKR 4,500"
            android:textColor="@color/customer_orange"
            android:textStyle="bold"
        />
    </LinearLayout>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="›"
        android:textSize="28sp"
    />
</LinearLayout>
